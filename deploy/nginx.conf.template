# Nginx site for the server, plain HTTP. The official Nginx image fills in ${SERVER_NAME} at start (envsubst replaces
# only variables that are set in the environment, so Nginx's own $variables stay as they are).

# The app, reached on the bare IP address.
server {
    listen 80 default_server;
    server_name _;

    root /usr/share/nginx/html;

    # /api/graph returns about 2.2 MB of JSON. text/event-stream is left out so the chat stream is never held back.
    gzip on;
    gzip_min_length 1024;
    gzip_types application/json application/javascript text/css image/svg+xml;

    location / {
        try_files $uri /index.html;
    }

    # Looking is open; everything that changes data or costs money (chat, layer builds, embeddings, settings, test
    # runs, the SQL viewer) needs the login.
    location /api/ {
        limit_except GET {
            auth_basic "AI2_VG";
            auth_basic_user_file /etc/nginx/.htpasswd;
        }

        proxy_pass http://backend:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # Chat answers and test runs are streamed as Server-Sent Events.
        proxy_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}

# The SQL viewer, on its own name (it links to absolute paths, so it cannot live under a sub-path). It runs inside the
# backend container once the app's `Open SQL Viewer` button has started it. It needs the login even for looking.
server {
    listen 80;
    server_name viewer.${SERVER_NAME};

    location / {
        auth_basic "AI2_VG";
        auth_basic_user_file /etc/nginx/.htpasswd;

        proxy_pass http://backend:5000;
        proxy_set_header Host $host;
        proxy_read_timeout 300s;
    }
}
